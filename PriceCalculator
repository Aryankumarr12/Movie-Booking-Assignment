#ifndef PRICECALCULATOR_CPP
#define PRICECALCULATOR_CPP

#include <vector>
using namespace std;

class PriceCalculator {
public:

    int calculateTotal(const vector<int>& prices) {

        int total = 0;

        for (int price : prices) {
            total += price;
        }

        return total;
    }

    int calculateTotal(int price1, int price2) {
        return price1 + price2;
    }
};

#endif
