#ifndef TICKETPRINTER_CPP
#define TICKETPRINTER_CPP

#include <iostream>
#include <vector>
#include "Booking.cpp"

using namespace std;

class TicketPrinter {

public:

    void printTicket(const Booking& booking) {

        cout << "\n";
        cout << "========================================\n";
        cout << "                 TICKET\n";
        cout << "========================================\n";

        cout << "Booking ID : "
             << booking.getBookingId() << endl;

        cout << "Movie      : "
             << booking.getMovieName() << endl;

        cout << "Screen     : "
             << booking.getScreenNumber() << endl;

        cout << "Time       : "
             << booking.getStartTime() << endl;

        cout << "Seats      : ";

        for (int seat : booking.getSeatNumbers()) {
            cout << seat << " ";
        }

        cout << endl;

        cout << "Total      : Rs. "
             << booking.getTotalAmount() << endl;

        cout << "Status     : CONFIRMED\n";

        cout << "========================================\n";
    }
};

#endif
